# Claude harness (worktrees are the main upload bloater)
/.claude/
/.agents/

# Project meta / docs
/docs/
/CLAUDE.md
/GLOSSARY.md
/PRODUCT.md
/README.md
/skills-lock.json

# Local dev infra (Supabase CLI state, not runtime)
/supabase/

# Test runners and reports — not needed for production build.
# Keep vitest.setup.ts in the upload because tsconfig includes test files and
# its jest-dom import provides the matcher types used while Next type-checks.
/e2e/
/playwright.config.ts
/playwright-report/
/test-results/
/vitest.config.ts
/proxy.test.ts

# Tooling / lint / git hooks
/biome.jsonc
/components.json
/lefthook.yml

# Build caches
/.next/
/tsconfig.tsbuildinfo

# Non-bun lockfiles — force Vercel to detect bun.lock and install with bun
/package-lock.json
/yarn.lock
/pnpm-lock.yaml

# Env files (Vercel uses its own dashboard-managed env vars)
/.env
/.env.*
